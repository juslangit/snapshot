; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Snapshot"
config/description="A photography game. One kampung morning, a camera with real settings, and a client who wants three pictures."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Game="*res://scripts/game_state.gd"
Sound="*res://scripts/sound.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

walk_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87,"pressed":false),Object(InputEventKey,"physical_keycode":4194320,"pressed":false)]
}
walk_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83,"pressed":false),Object(InputEventKey,"physical_keycode":4194322,"pressed":false)]
}
walk_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65,"pressed":false),Object(InputEventKey,"physical_keycode":4194319,"pressed":false)]
}
walk_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68,"pressed":false),Object(InputEventKey,"physical_keycode":4194321,"pressed":false)]
}
crouch={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194326,"pressed":false)]
}
raise_camera={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":2,"pressed":false)]
}
shutter={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1,"pressed":false)]
}

[physics]

3d/default_gravity=9.8

[rendering]

textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/use_physical_light_units=true
environment/defaults/default_clear_color=Color(0.53, 0.68, 0.79, 1)
